# ─── 数据面：走 socket/TCP over CX7 直连链路（本方案的关键选择）─────────────
# 三角拓扑下 NCCL 的 IB 路径不可用（见 docs/ROCE-INVESTIGATION.md），
# 因此显式选择 socket，并把 socket 指向 fabric 直连网卡。
NCCL_NET=Socket
NCCL_IB_DISABLE=1
NCCL_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=wlP9s9

# ─── 会话/训练调优（沿用厂商配方默认值）────────────────────────────────────
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,ENV
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_MAX_NCHANNELS=8
NCCL_PROTO='^LL128'
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1

# ─── 内存水位（低于 0.944 会报 "Loaded weights leave no GPU memory for the KV cache"）
MEM_FRACTION_STATIC=0.95
HEAD_MEM_FRACTION_STATIC=0.95

# ─── 节点与拓扑（按你的实际地址填写；示例为已脱敏的占位值）─────────────────
NODE1_IP=192.168.0.101
NODE2_IP=192.168.0.102
NODE3_IP=192.168.0.103
WORKER1_HOST=node2
WORKER2_HOST=node3
NNODES=3
TP_SIZE=3

# ─── 若将来恢复 RoCE（需交换机 / 上游修好），这些是三角拓扑的候选参数 ──────
# 注意：目前实测均不可用，保留仅作记录
# NCCL_NET=IB
# NCCL_IB_DISABLE=0
# NCCL_IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
# NCCL_IB_GID_INDEX=3
# NCCL_IB_MERGE_NICS=0
# NCCL_IB_SUBNET_AWARE_ROUTING=1
# NCCL_NET_PLUGIN=none
# NCCL_CROSS_NIC=1
