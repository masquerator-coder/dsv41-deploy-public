# ─── 数据面：走 RoCE/IB over CX7 直连链路（当前方案，2026-09-19 实测可用）─────
# 前提（缺一不可）：① 接线为"每条缆 p0↔p1"的交叉环；② 内核 6.17.0-1031-nvidia + 驱动 580.173.02
# （7.0.0-1019 有 CMA 回归 → ibv_reg_mr_iova2 ENOMEM）；③ 清掉镜像 /etc/nccl.conf 里的
# NCCL_IB_USE_INLINE / NCCL_IB_PREPOST_RECEIVE_WORK_REQUESTS（置 0）。
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1      # 每台两个逻辑口 = 域0 的两个物理口
NCCL_IB_GID_INDEX=3
NCCL_IB_SUBNET_AWARE_ROUTING=1          # 交叉环下靠它逐连接选对网卡，不要关
NCCL_IB_MERGE_NICS=0
NCCL_NET_PLUGIN=none
NCCL_CROSS_NIC=0
NCCL_SOCKET_IFNAME=wlP9s9               # 控制面走管理网（设成 fabric 口会静默死）
GLOO_SOCKET_IFNAME=wlP9s9

# ─── 回退档：若 RoCE 出问题，改用 socket/TCP over 同一批 CX7 链路 ─────────────
# 实测单流 17.9–19.2 tok/s、4 并发 39.7–43.3（约为 RoCE 档的 55%）
# NCCL_NET=Socket
# NCCL_IB_DISABLE=1
# NCCL_SOCKET_IFNAME=enp1s0f0np0
# GLOO_SOCKET_IFNAME=wlP9s9

# ─── 会话/训练调优（沿用厂商配方默认值）────────────────────────────────────
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,ENV
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_MAX_NCHANNELS=8
NCCL_PROTO='^LL128'
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1

# ─── 内存水位（低于 0.944 会报 "Loaded weights leave no GPU memory for the KV cache"）
MEM_FRACTION_STATIC=0.95
HEAD_MEM_FRACTION_STATIC=0.95

# ─── 节点与拓扑（按你的实际地址填写；示例为已脱敏的占位值）─────────────────
NODE1_IP=192.168.0.101
NODE2_IP=192.168.0.102
NODE3_IP=192.168.0.103
WORKER1_HOST=node2
WORKER2_HOST=node3
NNODES=3
TP_SIZE=3

# ─── 若将来恢复 RoCE（需交换机 / 上游修好），这些是三角拓扑的候选参数 ──────
# 注意：目前实测均不可用，保留仅作记录
# NCCL_NET=IB
# NCCL_IB_DISABLE=0
# NCCL_IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
# NCCL_IB_GID_INDEX=3
# NCCL_IB_MERGE_NICS=0
# NCCL_IB_SUBNET_AWARE_ROUTING=1
# NCCL_NET_PLUGIN=none
# NCCL_CROSS_NIC=1
